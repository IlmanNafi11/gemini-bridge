[Unit]
Description=Gemini Bridge OpenAI-compatible Gemini Web service
Documentation=https://github.com/OWNER/gemini-bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gemini-bridge
Group=gemini-bridge
ExecStart=/usr/local/bin/gemini-bridge --config /etc/gemini-bridge/bridge.toml
Environment=BRIDGE_STORAGE_DATA_DIR=/var/lib/gemini-bridge
Environment=HOME=/var/lib/gemini-bridge
EnvironmentFile=-/etc/gemini-bridge/environment
WorkingDirectory=/var/lib/gemini-bridge
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gemini-bridge
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
